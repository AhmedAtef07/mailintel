{
  "$schema": "https://unpkg.com/release-it@latest/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": null
  },
  "npm": {
    "publish": false
  }
}
